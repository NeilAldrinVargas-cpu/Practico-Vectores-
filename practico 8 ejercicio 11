#include <iostream>

using namespace std;

// --- FUNCIÓN PARA CONTAR TIPOS DE NÚMEROS ---
// Usamos referencias (&) en los contadores para que los cambios se guarden en el main
void contarTipos(double arreglo[], int tamano, int& pos, int& neg, int& ceros) {
    // Aseguramos que los contadores arranquen limpios en 0
    pos = 0;
    neg = 0;
    ceros = 0;

    // Recorremos todo el vector clasificando cada elemento
    for (int i = 0; i < tamano; i++) {
        if (arreglo[i] > 0) {
            pos++; // Suma uno a los positivos
        } 
        else if (arreglo[i] < 0) {
            neg++; // Suma uno a los negativos
        } 
        else {
            ceros++; // Suma uno a los ceros
        }
    }
}

// --- FUNCIÓN PRINCIPAL ---
int main() {
    int cantidad;

    // 1. Pedimos la cantidad de elementos
    cout << "Ingrese la cantidad de elementos del vector: ";
    cin >> cantidad;

    double numeros[cantidad];

    // 2. El usuario ingresa los datos por teclado
    cout << "\n--- Ingreso de datos ---" << endl;
    for (int i = 0; i < cantidad; i++) {
        cout << "Elemento [" << i + 1 << "]: ";
        cin >> numeros[i];
    }

    // Variables que contendrán las respuestas finales
    int positivos, negativos, ceros;

    // 3. Llamamos a la función enviando las variables para que las rellene
    contarTipos(numeros, cantidad, positivos, negativos, ceros);

    // 4. Mostramos los conteos en pantalla
    cout << "\n--- CONTEO FINAL ---" << endl;
    cout << "Cantidad de Numeros Positivos: " << positivos << endl;
    cout << "Cantidad de Numeros Negativos: " << negativos << endl;
    cout << "Cantidad de Ceros:             " << ceros << endl;

    return 0;
}
