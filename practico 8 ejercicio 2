#include <iostream>

using namespace std;

// --- FUNCIÓN PARA ENCONTRAR EL MÍNIMO ---
double obtenerMinimo(double arreglo[], int tamano) {
    double minimo = arreglo[0];

    for (int i = 1; i < tamano; i++) {
        if (arreglo[i] < minimo) {
            minimo = arreglo[i];
        }
    }
    return minimo;
}

// --- FUNCIÓN PRINCIPAL ---
int main() {
    int cantidad;

    // 1. Preguntamos cuántos elementos tendrá el vector
    cout << "Ingrese la cantidad de numeros que va a introducir: ";
    cin >> cantidad;

    // 2. Creamos el arreglo con el tamaño que el usuario eligió
    double numeros[cantidad];

    // 3. Bucle para que el usuario ingrese cada uno de los valores
    cout << "\n--- Ingreso de datos ---" << endl;
    for (int i = 0; i < cantidad; i++) {
        cout << "Ingrese el valor para la posicion [" << i + 1 << "]: ";
        cin >> numeros[i]; // Guarda el número en el arreglo
    }

    // 4. Llamamos a la función mandando los datos ingresados
    double valorMinimo = obtenerMinimo(numeros, cantidad);

    // 5. Mostramos el resultado final
    cout << "\n--------------------------------" << endl;
    cout << "El valor minimo ingresado es: " << valorMinimo << endl;

    return 0;
}
