#include <iostream>

using namespace std;

// --- FUNCIÓN QUE DETERMINA SI ES CAPICÚA ---
// Devuelve 'true' (verdadero) si es capicúa, o 'false' (falso) si no lo es
bool esCapicua(double arreglo[], int tamano) {
    int inicio = 0;
    int fin = tamano - 1;

    // Mientras los índices no se crucen en el centro
    while (inicio < fin) {
        // Si los valores de los extremos son diferentes, no es capicúa
        if (arreglo[inicio] != arreglo[fin]) {
            return false; 
        }
        // Movemos los índices hacia el centro
        inicio++;
        fin--;
    }
    
    // Si el bucle terminó sin problemas, significa que todos coincidieron
    return true; 
}

// --- FUNCIÓN PRINCIPAL ---
int main() {
    int cantidad;

    // 1. Pedimos la cantidad de elementos
    cout << "Ingrese la cantidad de elementos del vector: ";
    cin >> cantidad;

    double numeros[cantidad];

    // 2. El usuario ingresa los datos por teclado
    cout << "\n--- Ingreso de datos ---" << endl;
    for (int i = 0; i < cantidad; i++) {
        cout << "Elemento [" << i + 1 << "]: ";
        cin >> numeros[i];
    }

    // 3. Llamamos a la función condicional
    cout << "\n--------------------------------" << endl;
    if (esCapicua(numeros, cantidad)) {
        cout << "RESULTADO: El vector SI es capicua." << endl;
    } else {
        cout << "RESULTADO: El vector NO es capicua." << endl;
    }

    return 0;
}
