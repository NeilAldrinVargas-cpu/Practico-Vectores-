#include <iostream>

using namespace std;

// --- DEFINICIÓN DE LA FUNCIÓN ---
// Recibe el arreglo tradicional y su tamaño como parámetros
double obtenerMaximo(double arreglo[], int tamano) {
    // Asumimos que el primer elemento es el máximo inicial
    double maximo = arreglo[0];

    // Recorremos las posiciones restantes
    for (int i = 1; i < tamano; i++) {
        if (arreglo[i] > maximo) {
            maximo = arreglo[i]; // Actualizamos si encontramos uno mayor
        }
    }

    return maximo;
}

// --- FUNCIÓN PRINCIPAL ---
int main() {
    // Definimos el tamaño del arreglo
    const int TAMANO = 6;
    
    // Creamos el arreglo estático con números reales y enteros
    double numeros[TAMANO] = {14.5, 3.2, 45.1, 28.0, 9.9, 45.0};

    // Llamamos a la función pasándole el arreglo y su tamaño
    double valorMaximo = obtenerMaximo(numeros, TAMANO);

    // Mostramos el resultado
    cout << "El valor maximo encontrado es: " << valorMaximo << endl;

    return 0;
