#include <iostream>

using namespace std;

// --- FUNCIÓN PARA REVERTIR EL VECTOR SOBRE SÍ MISMO ---
void revertirEnElMismo(double arreglo[], int tamano) {
    int inicio = 0;
    int fin = tamano - 1;

    // Solo recorremos hasta encontrarnos en el centro
    while (inicio < fin) {
        // Truco del intercambio usando una variable de auxilio
        double aux = arreglo[inicio];
        arreglo[inicio] = arreglo[fin];
        arreglo[fin] = aux;

        // Movemos los extremos hacia el centro
        inicio++;
        fin--;
    }
}

// --- FUNCIÓN PRINCIPAL ---
int main() {
    int cantidad;

    // 1. Pedimos la cantidad de elementos
    cout << "Ingrese la cantidad de elementos del vector: ";
    cin >> cantidad;

    double numeros[cantidad];

    // 2. El usuario ingresa los datos por teclado
    cout << "\n--- Ingreso de datos ---" << endl;
    for (int i = 0; i < cantidad; i++) {
        cout << "Elemento [" << i + 1 << "]: ";
        cin >> numeros[i];
    }

    // 3. Llamamos a la función (esta modificará el arreglo 'numeros' directamente)
    revertirEnElMismo(numeros, cantidad);

    // 4. Mostramos el vector modificado
    cout << "\n--- VECTOR REVERTIDO (En el mismo vector) ---" << endl;
    cout << "[ ";
    for (int i = 0; i < cantidad; i++) {
        cout << numeros[i] << " ";
    }
    cout << "]" << endl;

    return 0;
}
